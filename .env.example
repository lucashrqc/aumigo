# --- Database ---
DATABASE_URL="postgresql://aumor:aumor@localhost:5432/aumor?sslmode=disable"
# Neon (prod): postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/aumor?sslmode=require

# --- BetterAuth (secret: openssl rand -base64 32) ---
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NUXT_PUBLIC_AUTH_BASE_URL="http://localhost:3000"

# --- SEO canonical URL (prod: production URL) ---
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudflare Web Analytics (prod only) ---
NUXT_PUBLIC_CF_ANALYTICS_TOKEN=""

# --- First admin (pnpm db:seed) ---
SEED_ADMIN_EMAIL="admin@aumor.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Aumor Admin"

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend (transactional email; leave key blank to log emails to console) ---
# Get a key at https://resend.com/api-keys (Sending access is enough).
RESEND_API_KEY=""
# Test sender (free, no domain) delivers only to your Resend account email.
# Swap to "Aumor <no-reply@yourdomain>" once you verify a domain in Resend.
RESEND_FROM_EMAIL="onboarding@resend.dev"
