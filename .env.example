# --- Database (Neon in prod, Docker Postgres locally) ---
# Local Docker default (see docker-compose.yml):
DATABASE_URL="postgresql://aumor:aumor@localhost:5432/aumor?sslmode=disable"
# Neon example (prod / Vercel):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/aumor?sslmode=require"

# --- BetterAuth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Exposed to the client (public runtime config)
NUXT_PUBLIC_AUTH_BASE_URL="http://localhost:3000"

# --- First admin, created by `pnpm db:seed` ---
SEED_ADMIN_EMAIL="admin@aumor.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Aumor Admin"

# --- Google OAuth (scaffolded, disabled until filled in) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
